# ==============================================================================
# IncidentPilot — Production & Development Environment Configuration
# ==============================================================================

# Application Metadata
APP_NAME=IncidentPilot
APP_VERSION=0.1.0
ENVIRONMENT=development    # Options: development, test, production
LOG_LEVEL=INFO             # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Connection
# In Development: SQLite (default: sqlite+pysqlite:///./incidentpilot.db)
# In Production: PostgreSQL (Required! e.g., postgresql+psycopg://incidentpilot:DB_PASSWORD@postgres:5432/incidentpilot)
DATABASE_URL=sqlite+pysqlite:///./incidentpilot.db

# Database Connection Pool (PostgreSQL tuning)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & Security
# In Production: Minimum 32-character high-entropy secret (Required!)
JWT_SECRET=change-this-to-a-secure-random-32-character-secret-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=incidentpilot
JWT_AUDIENCE=incidentpilot-api

# CORS Allowed Origins
# In Production: Explicit domains e.g., ["https://incidentpilot.yourdomain.com"] (Wildcards prohibited in production)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:8000"]

# Agora RTC Voice Configuration (Real-Time Communication Layer)
# Obtain from Agora Developer Console (https://console.agora.io)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_TOKEN_EXPIRE_SECONDS=3600

# External Incident Tool Integrations (Optional)
# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Jira Integration
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_API_TOKEN=your-jira-api-token-here

# Monitoring Source (Datadog/CloudWatch)
MONITORING_API_KEY=your-datadog-api-key-here
